{
  "name": "@shrinivas-sn/adapter-ingestion",
  "version": "0.3.0",
  "description": "Scheduled ingestion of JSON APIs and HTML pages into a local JSONL store, with change detection, a read-time relevance filter, and a canary that flags a source that changed shape or went quiet.",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrinivas-sn/adapter-ingestion.git"
  },
  "keywords": [
    "html",
    "scraping",
    "json-api",
    "ingestion",
    "etl",
    "cron",
    "adapter",
    "canary"
  ],
  "files": [
    "src",
    "README.md",
    "NOTES-generalization.md",
    "MIGRATION-0.2.md",
    "VERSIONING.md",
    "UPGRADING.md"
  ],
  "exports": {
    ".": "./src/run.mjs",
    "./adapter": "./src/adapter.mjs",
    "./canary": "./src/canary.mjs",
    "./contract": "./src/contract.mjs",
    "./dedupe": "./src/dedupe.mjs",
    "./extract": "./src/extract.mjs",
    "./fetch": "./src/fetch.mjs",
    "./filter": "./src/filter.mjs",
    "./normalize": "./src/normalize.mjs",
    "./report": "./src/report.mjs",
    "./store": "./src/store.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "ingest": "node src/run.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "cheerio": "^1.2.0"
  },
  "peerDependencies": {
    "cheerio": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "cheerio": {
      "optional": true
    }
  }
}
