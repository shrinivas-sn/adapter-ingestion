{
  "name": "@shrinivas-sn/adapter-ingestion",
  "version": "0.3.0",
  "description": "Scheduled ingestion of JSON APIs and HTML pages into a local JSONL store, with change detection, a read-time relevance filter, and a canary that flags a source that changed shape or went quiet.",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrinivas-sn/adapter-ingestion.git"
  },
  "keywords": [
    "html",
    "scraping",
    "json-api",
    "ingestion",
    "etl",
    "cron",
    "adapter",
    "canary"
  ],
  "files": [
    "src",
    "schema",
    "types",
    "README.md",
    "NOTES-generalization.md",
    "MIGRATION-0.2.md",
    "VERSIONING.md",
    "UPGRADING.md"
  ],
  "exports": {
    ".": {
      "types": "./types/run.d.mts",
      "default": "./src/run.mjs"
    },
    "./adapter": {
      "types": "./types/adapter.d.mts",
      "default": "./src/adapter.mjs"
    },
    "./canary": {
      "types": "./types/canary.d.mts",
      "default": "./src/canary.mjs"
    },
    "./contract": {
      "types": "./types/contract.d.mts",
      "default": "./src/contract.mjs"
    },
    "./dedupe": {
      "types": "./types/dedupe.d.mts",
      "default": "./src/dedupe.mjs"
    },
    "./extract": {
      "types": "./types/extract.d.mts",
      "default": "./src/extract.mjs"
    },
    "./fetch": {
      "types": "./types/fetch.d.mts",
      "default": "./src/fetch.mjs"
    },
    "./filter": {
      "types": "./types/filter.d.mts",
      "default": "./src/filter.mjs"
    },
    "./normalize": {
      "types": "./types/normalize.d.mts",
      "default": "./src/normalize.mjs"
    },
    "./report": {
      "types": "./types/report.d.mts",
      "default": "./src/report.mjs"
    },
    "./store": {
      "types": "./types/store.d.mts",
      "default": "./src/store.mjs"
    },
    "./adapter.schema.json": "./schema/adapter.schema.json"
  },
  "bin": {
    "adapter-ingestion": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ingest": "node src/run.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset publish",
    "build:types": "tsc -p tsconfig.json",
    "prepack": "npm run build:types"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "cheerio": "^1.2.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "cheerio": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "cheerio": {
      "optional": true
    }
  }
}
