{
  "include": ["src"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "target": "es2022",
    "outDir": "types",
    "rootDir": "src",
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
